APP_NAME=AI vs Real Detection API
APP_VERSION=1.0.0

# auto chooses CUDA when available, otherwise CPU.
MODEL_DEVICE=auto

# Server-local model directory containing:
# - model.py
# - pytorch_model.pt
BOMBEK1_MODEL_DIR=backend/models/bombek1

# Set true if you want the API to block startup until the model is loaded.
LOAD_MODEL_ON_STARTUP=false

# Next.js development origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_THRESHOLD=0.50
UNCERTAINTY_MARGIN=0.10
MAX_UPLOAD_MB=15
